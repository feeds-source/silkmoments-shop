<section class="wrap section" style="max-width:28rem">
  <p class="kicker">Account</p>
  <h1 class="display" style="font-style:italic">Join the house</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="First name" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <input type="text" name="customer[last_name]" placeholder="Last name" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <input type="email" name="customer[email]" placeholder="Email" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <input type="password" name="customer[password]" placeholder="Password" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <button class="btn" type="submit">Create account</button>
  {% endform %}
</section>
