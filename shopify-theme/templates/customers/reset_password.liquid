<section class="wrap section" style="max-width:28rem">
  <h1 class="display" style="font-style:italic">Reset password</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="customer[password]" placeholder="New password" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <input type="password" name="customer[password_confirmation]" placeholder="Confirm" style="display:block;width:100%;height:2.75rem;margin:0.75rem 0;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.75rem">
    <button class="btn" type="submit">Save</button>
  {% endform %}
</section>
