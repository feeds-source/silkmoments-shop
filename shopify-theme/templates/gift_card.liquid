<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Gift card · {{ shop.name }}</title>
    {{ 'femme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="wrap section">
      <p class="kicker">{{ shop.name }}</p>
      <h1 class="display" style="font-style:italic">Gift card</h1>
      <p class="price" style="font-size:2rem;color:var(--accent)">{{ gift_card.balance | money }}</p>
      <p>{{ gift_card.code | format_code }}</p>
    </main>
  </body>
</html>
