<div class="wrap section" id="finder">
  <p class="kicker">Fit lab</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Find your size</h2>
  <p class="muted" style="max-width:32rem;margin-top:0.75rem">Underbust and bust give the bra. Waist and hip vote on body, nighty, gown, and corset. Height and thigh set the hose.</p>
  <form class="fit-lab" data-fit>
    <div class="fit-units" data-fit-units>
      <button type="button" class="pill is-on" data-unit="cm">cm</button>
      <button type="button" class="pill" data-unit="in">in</button>
    </div>
    <div class="fit-grid">
      <label>Underbust <input type="number" min="0" step="0.5" name="under" inputmode="decimal"></label>
      <label>Bust <input type="number" min="0" step="0.5" name="bust" inputmode="decimal"></label>
      <label>Waist <input type="number" min="0" step="0.5" name="waist" inputmode="decimal"></label>
      <label>Hip <input type="number" min="0" step="0.5" name="hip" inputmode="decimal"></label>
      <label>Height <input type="number" min="0" step="0.5" name="height" inputmode="decimal"></label>
      <label>Thigh <input type="number" min="0" step="0.5" name="thigh" inputmode="decimal"></label>
    </div>
    <p class="subtle" data-fit-hint>Enter underbust and bust for a bra; waist and hip for body; height for hose.</p>
    <ul class="fit-out" data-fit-out hidden></ul>
  </form>
</div>

<div class="wrap section" id="visuals">
  <p class="kicker">Visual charts</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Where the tape sits</h2>
  <div class="measure-grid">
    <figure class="measure-fig">
      <img src="{{ 'measure-front.jpg' | asset_url }}" alt="Front: where the tape sits" width="1152" height="1728">
      <div class="measure-mark" style="top:38%"><div class="gold-rule"></div><span>Bust</span></div>
      <div class="measure-mark" style="top:44%"><div class="gold-rule"></div><span>Underbust</span></div>
      <div class="measure-mark" style="top:51%"><div class="gold-rule"></div><span>Waist</span></div>
      <div class="measure-mark" style="top:63%"><div class="gold-rule"></div><span>Hip</span></div>
      <figcaption>Front: where the tape sits</figcaption>
    </figure>
    <figure class="measure-fig">
      <img src="{{ 'measure-side.jpg' | asset_url }}" alt="Side: bust, waist, hip" width="1152" height="1728">
      <div class="measure-mark" style="top:38%"><div class="gold-rule"></div><span>Bust</span></div>
      <div class="measure-mark" style="top:44%"><div class="gold-rule"></div><span>Underbust</span></div>
      <div class="measure-mark" style="top:51%"><div class="gold-rule"></div><span>Waist</span></div>
      <div class="measure-mark" style="top:63%"><div class="gold-rule"></div><span>Hip</span></div>
      <figcaption>Side: bust, waist, hip</figcaption>
    </figure>
  </div>

  <p class="kicker" style="margin-top:3rem">Cups we cut</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Bra map</h2>
  <div class="bra-heat">
    <div class="lab"></div><div class="lab">A</div><div class="lab">B</div><div class="lab">C</div><div class="lab">D</div>
    <div class="lab">30</div>
    <div class="heat-off">—</div><div class="heat-on">30B</div><div class="heat-off">—</div><div class="heat-off">—</div>
    <div class="lab">32</div>
    <div class="heat-on">32A</div><div class="heat-on">32B</div><div class="heat-on">32C</div><div class="heat-on">32D</div>
    <div class="lab">34</div>
    <div class="heat-on">34A</div><div class="heat-on">34B</div><div class="heat-on">34C</div><div class="heat-on">34D</div>
    <div class="lab">36</div>
    <div class="heat-off">—</div><div class="heat-on">36B</div><div class="heat-on">36C</div><div class="heat-on">36D</div>
    <div class="lab">38</div>
    <div class="heat-off">—</div><div class="heat-on">38B</div><div class="heat-on">38C</div><div class="heat-on">38D</div>
    <div class="lab">40</div>
    <div class="heat-off">—</div><div class="heat-on">40B</div><div class="heat-on">40C</div><div class="heat-off">—</div>
    <div class="lab">42</div>
    <div class="heat-off">—</div><div class="heat-on">42B</div><div class="heat-on">42C</div><div class="heat-off">—</div>
  </div>

  <div class="bars">
    <article>
      <p class="kicker">Cup volume · bust minus band</p>
      {% assign cups = "A:59:12–14,B:68:14–16,C:77:16–18,D:86:18–20" | split: "," %}
      {% for c in cups %}
        {% assign p = c | split: ":" %}
        <div class="bar-row">
          <span>{{ p[0] }}</span>
          <div class="bar-track"><div class="bar-fill" style="width:{{ p[1] }}%"></div></div>
          <span class="subtle">{{ p[2] }} cm</span>
        </div>
      {% endfor %}
    </article>
    <article>
      <p class="kicker">Band · underbust cm</p>
      {% assign bands = "30:18:63–67,32:29:68–72,34:43:73–77,36:57:78–82,38:71:83–87,40:86:88–92,42:100:93–97" | split: "," %}
      {% for b in bands %}
        {% assign p = b | split: ":" %}
        <div class="bar-row">
          <span>{{ p[0] }}</span>
          <div class="bar-track"><div class="bar-fill blush" style="width:{{ p[1] }}%"></div></div>
          <span class="subtle">{{ p[2] }}</span>
        </div>
      {% endfor %}
    </article>
  </div>

  <p class="kicker" style="margin-top:3rem">XS to XXL</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Body ranges</h2>
  <div class="range-chart">
    <p class="kicker">Bust · waist · hip, cm · scale 55–125</p>
    <div class="range-row"><span>XS</span><div class="range-track">
      <i class="bust" style="left:32.9%;width:5.7%"></i>
      <i class="waist" style="left:7.1%;width:5.7%"></i>
      <i class="hip" style="left:44.3%;width:5.7%"></i>
    </div></div>
    <div class="range-row"><span>S</span><div class="range-track">
      <i class="bust" style="left:40%;width:5.7%"></i>
      <i class="waist" style="left:14.3%;width:5.7%"></i>
      <i class="hip" style="left:51.4%;width:5.7%"></i>
    </div></div>
    <div class="range-row"><span>M</span><div class="range-track">
      <i class="bust" style="left:47.1%;width:5.7%"></i>
      <i class="waist" style="left:21.4%;width:5.7%"></i>
      <i class="hip" style="left:58.6%;width:5.7%"></i>
    </div></div>
    <div class="range-row"><span>L</span><div class="range-track">
      <i class="bust" style="left:54.3%;width:5.7%"></i>
      <i class="waist" style="left:28.6%;width:5.7%"></i>
      <i class="hip" style="left:65.7%;width:5.7%"></i>
    </div></div>
    <div class="range-row"><span>XL</span><div class="range-track">
      <i class="bust" style="left:61.4%;width:8.6%"></i>
      <i class="waist" style="left:35.7%;width:8.6%"></i>
      <i class="hip" style="left:72.9%;width:8.6%"></i>
    </div></div>
    <div class="range-row"><span>XXL</span><div class="range-track">
      <i class="bust" style="left:71.4%;width:10%"></i>
      <i class="waist" style="left:45.7%;width:10%"></i>
      <i class="hip" style="left:82.9%;width:10%"></i>
    </div></div>
    <p class="range-legend">
      <span><b style="background:var(--accent)"></b>Bust</span>
      <span><b style="background:var(--blush)"></b>Waist</span>
      <span><b style="background:var(--muted)"></b>Hip</span>
    </p>
  </div>

  <div class="bars" style="margin-top:2rem">
    <article>
      <p class="kicker">Size progression · midpoints cm</p>
      {% assign mids = "XS:36:22:44,S:43:27:51,M:50:31:59,L:57:36:66,XL:66:43:74,XXL:76:51:84" | split: "," %}
      {% for row in mids %}
        {% assign p = row | split: ":" %}
        <div class="bar-row">
          <span>{{ p[0] }}</span>
          <div class="bar-track stacked">
            <div class="bar-fill" style="width:{{ p[1] }}%"></div>
          </div>
        </div>
        <div class="bar-row">
          <span></span>
          <div class="bar-track stacked">
            <div class="bar-fill blush" style="width:{{ p[2] }}%"></div>
          </div>
        </div>
        <div class="bar-row">
          <span></span>
          <div class="bar-track stacked">
            <div class="bar-fill muted" style="width:{{ p[3] }}%"></div>
          </div>
        </div>
      {% endfor %}
      <p class="range-legend" style="margin-top:0.75rem">
        <span><b style="background:var(--accent)"></b>Bust</span>
        <span><b style="background:var(--blush)"></b>Waist</span>
        <span><b style="background:var(--muted)"></b>Hip</span>
      </p>
    </article>
  </div>
</div>

<div class="wrap section" id="convert">
  <p class="kicker">UK · US · EU · FR · IT · AU · PK</p>
  <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">International conversion</h2>
  <p class="muted" style="max-width:32rem;margin-top:0.75rem">House labels are UK/US band and XS–XXL. Match a label from another market here before you order.</p>
  <div class="range-chart">
    <p class="kicker">Dress numbers · UK / US / EU</p>
    {% assign dress = "XS:10:4:33,S:18:10:37,M:26:18:41,L:34:26:45,XL:42:34:49,XXL:50:42:53" | split: "," %}
    {% for row in dress %}
      {% assign p = row | split: ":" %}
      <div class="range-row"><span>{{ p[0] }}</span><div class="range-track">
        <i class="bust" style="left:0;width:{{ p[1] }}%"></i>
        <i class="waist" style="left:0;width:{{ p[2] }}%"></i>
        <i class="hip" style="left:0;width:{{ p[3] }}%"></i>
      </div></div>
    {% endfor %}
    <p class="range-legend">
      <span><b style="background:var(--accent)"></b>UK</span>
      <span><b style="background:var(--blush)"></b>US</span>
      <span><b style="background:var(--muted)"></b>EU</span>
    </p>
  </div>
  <div style="overflow-x:auto">
    <table class="chart-table">
      <thead><tr><th>UK / US</th><th>EU</th><th>FR / ES / BE</th><th>IT</th><th>AU / NZ</th><th>PK</th></tr></thead>
      <tbody>
        <tr><td>30</td><td>65</td><td>80</td><td>0</td><td>8</td><td>30</td></tr>
        <tr><td>32</td><td>70</td><td>85</td><td>1</td><td>10</td><td>32</td></tr>
        <tr><td>34</td><td>75</td><td>90</td><td>2</td><td>12</td><td>34</td></tr>
        <tr><td>36</td><td>80</td><td>95</td><td>3</td><td>14</td><td>36</td></tr>
        <tr><td>38</td><td>85</td><td>100</td><td>4</td><td>16</td><td>38</td></tr>
        <tr><td>40</td><td>90</td><td>105</td><td>5</td><td>18</td><td>40</td></tr>
        <tr><td>42</td><td>95</td><td>110</td><td>6</td><td>20</td><td>42</td></tr>
      </tbody>
    </table>
  </div>
  <p class="kicker" style="margin-top:2rem">Cup</p>
  <div style="overflow-x:auto">
    <table class="chart-table">
      <thead><tr><th>UK</th><th>US</th><th>EU</th><th>FR</th><th>Gap cm</th><th>Gap in</th></tr></thead>
      <tbody>
        <tr><td>A</td><td>A</td><td>A</td><td>A</td><td>12–14</td><td>1</td></tr>
        <tr><td>B</td><td>B</td><td>B</td><td>B</td><td>14–16</td><td>2</td></tr>
        <tr><td>C</td><td>C</td><td>C</td><td>C</td><td>16–18</td><td>3</td></tr>
        <tr><td>D</td><td>D</td><td>D</td><td>D</td><td>18–20</td><td>4</td></tr>
        <tr><td>DD</td><td>DD / E</td><td>E</td><td>E</td><td>20–22</td><td>5</td></tr>
      </tbody>
    </table>
  </div>
  <p class="subtle" style="margin-top:0.75rem;font-size:0.85rem">DD and above are not cut in this house.</p>
</div>

<div class="wrap section">
  <section id="bras" class="scroll-pad">
    <p class="kicker">Band + cup</p>
    <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Bras & bridal sets</h2>
    <p class="muted" style="max-width:32rem;margin-top:0.75rem">Match underbust to the band, then the gap to the cup. Empty cells are not in this house.</p>
    <div style="overflow-x:auto">
      <table class="chart-table">
        <thead><tr><th>Size</th><th>Underbust cm</th><th>Underbust in</th><th>Bust cm</th><th>Bust in</th><th>EU</th><th>FR</th><th>Sisters</th></tr></thead>
        <tbody>
          <tr><td>30B</td><td>63–67</td><td>25–26.5</td><td>77–83</td><td>30.3–32.7</td><td>65</td><td>80</td><td>32A</td></tr>
          <tr><td>32A</td><td>68–72</td><td>27–28.5</td><td>80–86</td><td>31.5–33.9</td><td>70</td><td>85</td><td>30B</td></tr>
          <tr><td>32B</td><td>68–72</td><td>27–28.5</td><td>82–88</td><td>32.3–34.6</td><td>70</td><td>85</td><td>34A</td></tr>
          <tr><td>32C</td><td>68–72</td><td>27–28.5</td><td>84–90</td><td>33.1–35.4</td><td>70</td><td>85</td><td>34B</td></tr>
          <tr><td>32D</td><td>68–72</td><td>27–28.5</td><td>86–92</td><td>33.9–36.2</td><td>70</td><td>85</td><td>34C · 36B</td></tr>
          <tr><td>34A</td><td>73–77</td><td>29–30.5</td><td>85–91</td><td>33.5–35.8</td><td>75</td><td>90</td><td>32B</td></tr>
          <tr><td>34B</td><td>73–77</td><td>29–30.5</td><td>87–93</td><td>34.3–36.6</td><td>75</td><td>90</td><td>32C · 36A*</td></tr>
          <tr><td>34C</td><td>73–77</td><td>29–30.5</td><td>89–95</td><td>35–37.4</td><td>75</td><td>90</td><td>32D · 36B</td></tr>
          <tr><td>34D</td><td>73–77</td><td>29–30.5</td><td>91–97</td><td>35.8–38.2</td><td>75</td><td>90</td><td>36C · 38B</td></tr>
          <tr><td>36B</td><td>78–82</td><td>31–32.5</td><td>92–98</td><td>36.2–38.6</td><td>80</td><td>95</td><td>34C · 32D</td></tr>
          <tr><td>36C</td><td>78–82</td><td>31–32.5</td><td>94–100</td><td>37–39.4</td><td>80</td><td>95</td><td>34D · 38B</td></tr>
          <tr><td>36D</td><td>78–82</td><td>31–32.5</td><td>96–102</td><td>37.8–40.2</td><td>80</td><td>95</td><td>38C · 40B</td></tr>
          <tr><td>38B</td><td>83–87</td><td>33–34.5</td><td>97–103</td><td>38.2–40.6</td><td>85</td><td>100</td><td>36C · 34D</td></tr>
          <tr><td>38C</td><td>83–87</td><td>33–34.5</td><td>99–105</td><td>39–41.3</td><td>85</td><td>100</td><td>36D · 40B</td></tr>
          <tr><td>38D</td><td>83–87</td><td>33–34.5</td><td>101–107</td><td>39.8–42.1</td><td>85</td><td>100</td><td>40C · 42B</td></tr>
          <tr><td>40B</td><td>88–92</td><td>35–36.5</td><td>102–108</td><td>40.2–42.5</td><td>90</td><td>105</td><td>38C · 36D</td></tr>
          <tr><td>40C</td><td>88–92</td><td>35–36.5</td><td>104–110</td><td>40.9–43.3</td><td>90</td><td>105</td><td>38D · 42B</td></tr>
          <tr><td>42B</td><td>93–97</td><td>37–38.5</td><td>107–113</td><td>42.1–44.5</td><td>95</td><td>110</td><td>40C · 38D</td></tr>
          <tr><td>42C</td><td>93–97</td><td>37–38.5</td><td>109–115</td><td>42.9–45.3</td><td>95</td><td>110</td><td>40D*</td></tr>
        </tbody>
      </table>
    </div>
    <p class="kicker" style="margin-top:2rem">Sister sizes</p>
    <p class="muted" style="margin-top:0.5rem">Same cup volume, neighbouring band. If a 34C is gone, try 32D or 36B.</p>
    {% assign sisters = "32A|30B,32B|30C|34A,32C|34B|36A,32D|34C|36B,34D|36C|38B,36D|38C|40B,38D|40C|42B,40C|42B,42C|40D" | split: "," %}
    {% for row in sisters %}
      {% assign sizes = row | split: "|" %}
      <div class="sister">
        {% for s in sizes %}
          {% unless forloop.first %}<span class="hair"></span>{% endunless %}
          <span class="pill">{{ s }}</span>
        {% endfor %}
      </div>
    {% endfor %}
    <p class="subtle" style="margin-top:1rem;font-size:0.85rem">Example: underbust 75 cm and bust 91 cm → 34C. * not cut in this house.</p>
  </section>

  <section id="body" class="scroll-pad" style="padding-top:4rem">
    <p class="kicker">XS–XXL</p>
    <h2 class="display" style="font-style:italic;margin:0.5rem 0 0">Body & lounge</h2>
    <div style="overflow-x:auto">
      <table class="chart-table">
        <thead><tr><th>Size</th><th>Bust cm</th><th>Waist cm</th><th>Hip cm</th><th>Bust in</th><th>Waist in</th><th>Hip in</th><th>UK</th><th>US</th><th>EU</th><th>AU</th><th>PK</th></tr></thead>
        <tbody>
          <tr><td>XS</td><td>78–82</td><td>60–64</td><td>86–90</td><td>30.5–32.5</td><td>23.5–25</td><td>34–35.5</td><td>4–6</td><td>0–2</td><td>32–34</td><td>4–6</td><td>30–32</td></tr>
          <tr><td>S</td><td>83–87</td><td>65–69</td><td>91–95</td><td>32.5–34.5</td><td>25.5–27</td><td>36–37.5</td><td>8–10</td><td>4–6</td><td>36–38</td><td>8–10</td><td>32–34</td></tr>
          <tr><td>M</td><td>88–92</td><td>70–74</td><td>96–100</td><td>34.5–36</td><td>27.5–29</td><td>38–39.5</td><td>12–14</td><td>8–10</td><td>40–42</td><td>12–14</td><td>34–36</td></tr>
          <tr><td>L</td><td>93–97</td><td>75–79</td><td>101–105</td><td>36.5–38</td><td>29.5–31</td><td>40–41.5</td><td>16–18</td><td>12–14</td><td>44–46</td><td>16–18</td><td>36–38</td></tr>
          <tr><td>XL</td><td>98–104</td><td>80–86</td><td>106–112</td><td>38.5–41</td><td>31.5–34</td><td>41.5–44</td><td>20–22</td><td>16–18</td><td>48–50</td><td>20–22</td><td>38–40</td></tr>
          <tr><td>XXL</td><td>105–112</td><td>87–94</td><td>113–120</td><td>41.5–44</td><td>34.5–37</td><td>44.5–47</td><td>24–26</td><td>20–22</td><td>52–54</td><td>24–26</td><td>40–42</td></tr>
        </tbody>
      </table>
    </div>
    <p class="kicker" style="margin-top:2rem">Panties</p>
    <div style="overflow-x:auto">
      <table class="chart-table">
        <thead><tr><th>Size</th><th>Hip cm</th><th>Hip in</th><th>Waist cm</th><th>Waist in</th></tr></thead>
        <tbody>
          <tr><td>XS</td><td>86–90</td><td>34–35.5</td><td>60–64</td><td>23.5–25</td></tr>
