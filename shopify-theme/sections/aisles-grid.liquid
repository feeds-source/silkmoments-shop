<section class="section">
  <div class="wrap">
    <p class="kicker">{{ section.settings.kicker }}</p>
    <h2>{{ section.settings.title }}</h2>
    <div class="grid-aisles">
      {% for block in section.blocks %}
        <a class="aisle group" href="{{ block.settings.link | default: collections[block.settings.collection].url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'ken-hover' }}
          {% else %}
            <img class="ken-hover" src="{{ block.settings.fallback | asset_url }}" alt="{{ block.settings.title | escape }}" width="1200" height="900">
          {% endif %}
          <div class="hero-veil"></div>
          <div class="aisle__copy">
            <p class="kicker">{{ block.settings.kicker }}</p>
            <h3>{{ block.settings.title }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aisles grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "New aisles" },
    { "type": "text", "id": "title", "label": "Title", "default": "More of the house" }
  ],
  "blocks": [
    {
      "type": "aisle",
      "name": "Aisle",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Category", "default": "Babydoll" },
        { "type": "text", "id": "title", "label": "Title", "default": "Short lace night" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Asset filename", "default": "aisle-babydoll.jpg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aisles grid",
      "blocks": [
        { "type": "aisle", "settings": { "kicker": "Babydoll", "title": "Short lace night", "fallback": "aisle-babydoll.jpg" } },
        { "type": "aisle", "settings": { "kicker": "Bra Sets", "title": "Balconette pairs", "fallback": "aisle-sets.jpg" } },
        { "type": "aisle", "settings": { "kicker": "Gowns", "title": "Satin after dusk", "fallback": "aisle-gowns.jpg" } },
        { "type": "aisle", "settings": { "kicker": "Swim", "title": "Jewel bikini", "fallback": "aisle-swim.jpg" } },
        { "type": "aisle", "settings": { "kicker": "Corsetry", "title": "Boning & gold", "fallback": "aisle-corset.jpg" } },
        { "type": "aisle", "settings": { "kicker": "Body Stockings", "title": "Sheer noir", "fallback": "aisle-body.jpg" } }
      ]
    }
  ]
}
{% endschema %}
