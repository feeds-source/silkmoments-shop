<section class="wrap section">
  <p class="kicker">Bag</p>
  <h1 class="display" style="font-style:italic">{{ 'cart.title' | t | default: 'Your Atelier Bag' }}</h1>

  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      <div style="margin: 1.5rem 0">
        {% render block %}
      </div>
    {% endif %}
  {% endfor %}

  {% if cart.item_count == 0 %}
    <p class="muted" style="margin-top:1rem">{{ 'cart.empty' | t | default: 'Your bag is empty.' }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}" style="margin-top:1.5rem">Shop the house</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <table class="cart-table">
        <thead>
          <tr><th>Piece</th><th>Size</th><th>Qty</th><th>Price</th></tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td>
                <a href="{{ item.url }}" style="display:flex;gap:0.75rem;align-items:center">
                  {% if item.image %}
                    {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy' }}
                  {% endif %}
                  <span>{{ item.product.title }}</span>
                </a>
              </td>
              <td class="muted">{{ item.variant.title }}</td>
              <td>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:4rem;height:2.5rem;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0 0.5rem">
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));gap:2rem;margin-top:2rem;align-items:start">
        {% if settings.enable_cart_notes %}
          <div class="cart-notes">
            <label class="kicker" for="cart-notes">Special instructions or gift note</label>
            <textarea id="cart-notes" name="note" rows="4" style="width:100%;margin-top:0.5rem;background:var(--elevated);border:1px solid var(--line);color:var(--fg);padding:0.75rem;border-radius:8px">{{ cart.note }}</textarea>
          </div>
        {% else %}
          <div></div>
        {% endif %}

        <div class="totals">
          <p style="font-size:1.15rem;display:flex;justify-content:space-between">
            <span class="muted">{{ 'cart.subtotal' | t | default: 'Subtotal' }}</span>
            <strong class="gold">{{ cart.total_price | money }}</strong>
          </p>
          <p class="subtle" style="font-size:0.8rem;margin-top:0.25rem">Taxes and shipping calculated at checkout</p>
          <button class="btn btn-ghost" type="submit" name="update" style="margin-top:1rem;width:100%">Update bag</button>
          <button class="btn" type="submit" name="checkout" style="margin-top:0.5rem;width:100%">{{ 'cart.checkout' | t | default: 'Proceed to Checkout' }}</button>
        </div>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
