    {% assign hero_img = 'body-stocking.jpg' %}{% assign hero_kick = 'Body' %}{% assign hero_body = 'Sheer noir lace, one piece. Free size, made to drape.' %}
  {% when 'loungewear' %}
    {% assign hero_img = 'lounge.jpg' %}{% assign hero_kick = 'After dusk' %}{% assign hero_body = 'Knit robes and wide-leg ease. Emerald after dusk.' %}
{% endcase %}

