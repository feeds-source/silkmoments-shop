<footer class="site-footer">
  <img src="{{ 'lounge.jpg' | asset_url }}" alt="" width="1600" height="1000" loading="lazy">
  <div class="footer-veil"></div>
  <div class="wrap site-footer__inner">
    <div class="grid-footer">
      <div class="brand-lockup">
        <p class="brand__name">{{ settings.brand_name | default: 'FEMME' }}</p>
        <p class="brand__sub">{{ settings.brand_sub | default: 'Silk Atelier' }}</p>
        <h2>{{ settings.brand_line | default: 'Exotic silk, cut for the body.' }}</h2>
        <p class="muted" style="margin-top:1rem;max-width:22rem">
          Jewel-tone lingerie, night, and lounge. Cash on delivery worldwide. A printable receipt at every order.
        </p>

        {% if settings.social_instagram_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank or settings.social_facebook_link != blank %}
          <div class="footer-socials" style="display:flex;gap:1rem;margin-top:1.5rem">
            {% if settings.social_instagram_link != blank %}
              <a class="subtle" href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            {% endif %}
            {% if settings.social_pinterest_link != blank %}
              <a class="subtle" href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener noreferrer">Pinterest</a>
            {% endif %}
            {% if settings.social_tiktok_link != blank %}
              <a class="subtle" href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer">TikTok</a>
            {% endif %}
            {% if settings.social_facebook_link != blank %}
              <a class="subtle" href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <div class="grid-footer-nav">
        <div>
          <h3>Night</h3>
          <ul>
            <li><a href="{{ collections.babydoll.url | default: routes.all_products_collection_url }}">Babydoll</a></li>
            <li><a href="{{ collections['short-nighty'].url | default: routes.all_products_collection_url }}">Short Nighty</a></li>
            <li><a href="{{ collections['long-nighty'].url | default: routes.all_products_collection_url }}">Long Nighty</a></li>
            <li><a href="{{ collections.gowns.url | default: routes.all_products_collection_url }}">Gowns</a></li>
            <li><a href="{{ collections.teddies.url | default: routes.all_products_collection_url }}">Teddies</a></li>
          </ul>
        </div>
        <div>
          <h3>Body</h3>
          <ul>
            <li><a href="{{ collections.bras.url | default: routes.all_products_collection_url }}">Bras</a></li>
            <li><a href="{{ collections['bra-sets'].url | default: routes.all_products_collection_url }}">Bra Sets</a></li>
            <li><a href="{{ collections.panties.url | default: routes.all_products_collection_url }}">Panties</a></li>
            <li><a href="{{ collections.camisole.url | default: routes.all_products_collection_url }}">Camisole</a></li>
            <li><a href="{{ collections.corsetry.url | default: routes.all_products_collection_url }}">Corsetry</a></li>
            <li><a href="{{ collections.hosiery.url | default: routes.all_products_collection_url }}">Hosiery</a></li>
            <li><a href="{{ collections['body-stockings'].url | default: routes.all_products_collection_url }}">Body Stockings</a></li>
            <li><a href="{{ collections.shapewear.url | default: routes.all_products_collection_url }}">Shapewear</a></li>
          </ul>
        </div>
        <div>
          <h3>After dusk</h3>
          <ul>
            <li><a href="{{ collections.bridal.url | default: routes.all_products_collection_url }}">Bridal</a></li>
            <li><a href="{{ collections.swim.url | default: routes.all_products_collection_url }}">Swim</a></li>
            <li><a href="{{ collections.loungewear.url | default: routes.all_products_collection_url }}">Loungewear</a></li>
            <li><a href="{{ collections.resort.url | default: routes.all_products_collection_url }}">Resort</a></li>
            <li><a href="{{ collections.thermal.url | default: routes.all_products_collection_url }}">Thermal</a></li>
            <li><a href="{{ collections.accessories.url | default: routes.all_products_collection_url }}">Accessories</a></li>
          </ul>
        </div>
        <div>
          <h3>House</h3>
          <ul>
            <li><a href="{{ pages.about.url | default: pages['the-atelier'].url }}">The atelier</a></li>
            <li><a href="{{ pages['size-guide'].url | default: '/pages/size-guide' }}">Size guide</a></li>
            <li><a href="{{ pages.contact.url }}">Contact</a></li>
            <li><a href="{{ routes.account_url }}">Orders</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
          </ul>
          <p class="subtle" style="margin-top:1.5rem;font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase">Write</p>
          <a class="gold" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email | default: 'info@silkmoments.com' }}</a>
        </div>
      </div>
    </div>

    <div class="gold-rule" style="margin-top:3.5rem"></div>

    <div class="legal" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1.5rem">
      <div>
        <p>{{ 'general.cod' | t | default: 'Cash on delivery worldwide' }} · {{ 'general.sizes' | t | default: 'Size guide support' }}</p>
        <p>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Silk Atelier</p>
      </div>

      {% render 'localization-selector' %}

      {% if settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="footer-payment-icons" style="display:flex;gap:0.5rem;flex-wrap:wrap">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
