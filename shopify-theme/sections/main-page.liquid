<section class="page-hero">
  <img class="ken" src="{{ 'hero.jpg' | asset_url }}" alt="" width="1600" height="1000" loading="eager">
  <div class="hero-veil"></div>
  <div class="wrap">
    <p class="kicker">House</p>
    <h1 class="display" style="font-style:italic;font-size:clamp(2.4rem,5vw,3.5rem);margin:0.5rem 0 0">{{ page.title }}</h1>
  </div>
</section>

<div class="wrap section" style="max-width:48rem">
  <div class="muted" style="line-height:1.7;font-size:1rem">{{ page.content }}</div>
  {% for block in section.blocks %}
    {% if block.type == '@app' %}
      <div style="margin-top:2rem">
        {% render block %}
      </div>
    {% endif %}
  {% endfor %}
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": []
}
{% endschema %}
