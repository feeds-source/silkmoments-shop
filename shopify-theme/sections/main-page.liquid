<section class="page-hero">
  <img class="ken" src="{{ 'hero.jpg' | asset_url }}" alt="" width="1600" height="1000">
  <div class="hero-veil"></div>
  <div class="wrap">
    <p class="kicker">House</p>
    <h1 class="display" style="font-style:italic;font-size:clamp(2.4rem,5vw,3.5rem);margin:0.5rem 0 0">{{ page.title }}</h1>
  </div>
</section>
<div class="wrap section" style="max-width:40rem">
  <div class="muted">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
