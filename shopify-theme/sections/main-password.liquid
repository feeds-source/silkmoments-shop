<section class="wrap section">
  <p class="kicker">Silk Atelier</p>
  <h1 class="display" style="font-style:italic">{{ shop.name }}</h1>
  <p class="muted" style="margin-top:0.75rem">The house is locked. Enter the password.</p>
  {% form 'storefront_password' %}
    <label class="kicker" for="password">Password</label>
    <input id="password" type="password" name="password" class="qty" style="width:100%;max-width:16rem;margin:0.75rem 0;display:block">
    <button class="btn" type="submit">Enter</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
