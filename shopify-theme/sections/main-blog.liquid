<section class="wrap section">
  <p class="kicker">Journal</p>
  <h1 class="display" style="font-style:italic">{{ blog.title }}</h1>
  <div class="grid-shop" style="margin-top:2rem">
    {% for article in blog.articles %}
      <article>
        <a href="{{ article.url }}">
          <div class="card-media">
            {% if article.image %}
              {{ article.image | image_url: width: 900 | image_tag: class: 'ken', alt: article.title, loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="card-body">
            <p class="cat">{{ article.published_at | date: '%d %b %Y' }}</p>
            <h3>{{ article.title }}</h3>
          </div>
        </a>
      </article>
    {% else %}
      <p class="muted">No journal yet.</p>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
